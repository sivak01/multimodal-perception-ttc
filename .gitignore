# Dataset (large, external — see config.py DATA_ROOT)
DATA SET/

# Generated pipeline outputs (regenerated by running the Step_*.ipynb notebooks)
# Written as output/* + nested negations (not a bare "output/") so the Step 8
# example-video exceptions further down this file can un-ignore specific
# nested files -- a bare "output/" stops git from ever looking inside it,
# even for a later "!" pattern.
output/*
!output/step_8/

# Rendered HTML exports of notebooks (regenerated, not hand-edited)
html/

# Historical/superseded notebook revisions
archive/
Old Codes/

# Model weights
*.pt

# Python
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# Pytest
.pytest_cache/

# Misc scratch
nb_summary.txt

# Claude Code local runtime state (not project content)
.claude/

# Office transient lock files
~$*.doc*

# Step 8 example videos — one day scene (scene-0061) and one night scene
# (scene-1077), both video styles, explicitly un-ignored by exception.
# Everything else under output/ (including the rest of step_8/) remains
# ignored as regenerable build output.
output/step_8/*
!output/step_8/videos/
!output/step_8/videos_detailed/
output/step_8/videos/*
!output/step_8/videos/scene-0061.mp4
!output/step_8/videos/scene-1077.mp4
output/step_8/videos_detailed/*
!output/step_8/videos_detailed/scene-0061.mp4
!output/step_8/videos_detailed/scene-1077.mp4

# Hugging Face Space deployment (its own git remote, not this repo --
# pushed directly to huggingface.co, holds all 10 scenes' videos)
huggingface_space/
